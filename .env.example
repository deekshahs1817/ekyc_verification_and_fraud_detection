# Complete Environment Variables Reference
# ==========================================

# 1. FRONTEND (Configure in Vercel Project Settings)
# --------------------------------------------------
# Production URL of your deployed FastAPI Backend
REACT_APP_API_URL=https://ekyc-backend.onrender.com
VITE_API_URL=https://ekyc-backend.onrender.com

# Google OAuth Client ID for SSO
REACT_APP_GOOGLE_CLIENT_ID=992314878877-vvul89n1rol4ohtbkebhse4fs2npkgtn.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=992314878877-vvul89n1rol4ohtbkebhse4fs2npkgtn.apps.googleusercontent.com


# 2. BACKEND (Configure in Render Web Service Environment)
# --------------------------------------------------------
PROJECT_NAME="AI-Powered eKYC & Fraud Detection Platform"
API_V1_STR=/api/v1

# JWT Secret Key (Generate with: openssl rand -hex 32)
JWT_SECRET_KEY=super-secret-production-jwt-key-replace-in-production-use-strong-entropy
SECRET_KEY=super-secret-production-jwt-key-replace-in-production-use-strong-entropy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# PostgreSQL Database Connection String
DATABASE_URL=postgresql://ekyc_user:password@dpg-xxxx.render.com/ekyc_db
USE_SQLITE_FALLBACK=True
SQLITE_DB_URL=sqlite:///./ekyc_app.db

# Google OAuth Authentication
GOOGLE_CLIENT_ID=992314878877-vvul89n1rol4ohtbkebhse4fs2npkgtn.apps.googleusercontent.com

# SMTP Email OTP Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@ekyc-verification.ai
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5

# Maximum Upload File Size in Megabytes
MAX_UPLOAD_SIZE_MB=15
