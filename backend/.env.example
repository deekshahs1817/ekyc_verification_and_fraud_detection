# Backend Environment Configuration Template
# Configure these variables in Render Dashboard -> Environment:

# Project Configuration
PROJECT_NAME="AI-Powered eKYC & Fraud Detection Platform"
API_V1_STR=/api/v1

# Security & JWT Token Authentication
# Generate a strong 64-character secret key: openssl rand -hex 32
JWT_SECRET_KEY=super-secret-production-jwt-key-replace-in-production-use-strong-entropy
SECRET_KEY=super-secret-production-jwt-key-replace-in-production-use-strong-entropy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Render Managed PostgreSQL or External)
# Example: postgresql://ekyc_user:password@dpg-xxxx.render.com/ekyc_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ekyc_db
USE_SQLITE_FALLBACK=True
SQLITE_DB_URL=sqlite:///./ekyc_app.db

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=992314878877-vvul89n1rol4ohtbkebhse4fs2npkgtn.apps.googleusercontent.com

# SMTP Configuration for Email OTP Delivery
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@ekyc-verification.ai
OTP_EXPIRE_MINUTES=5
MAX_OTP_ATTEMPTS=5

# CORS Allowed Origins (Comma-separated or list)
# Default regex automatically permits all *.vercel.app and *.onrender.com origins
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://ekyc-fraud-detection-app.vercel.app"]

# File Storage Configuration
MAX_UPLOAD_SIZE_MB=15
