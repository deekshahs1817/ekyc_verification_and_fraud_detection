# Application Settings
PROJECT_NAME="AI-Powered eKYC & Fraud Detection Platform"
API_V1_STR="/api/v1"
SECRET_KEY="super-secret-production-jwt-key-replace-in-production-use-strong-entropy"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Settings
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ekyc_db"
# Fallback to SQLite if PostgreSQL is not active
USE_SQLITE_FALLBACK=True
SQLITE_DB_URL="sqlite:///./ekyc_app.db"

# Storage Settings
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=15

# AI Model Configuration
MODEL_DIR="./app/services/ai/models"
CONFIDENCE_THRESHOLD_DOC=0.85
SIMILARITY_THRESHOLD_FACE=0.70
LIVENESS_THRESHOLD=0.60
TAMPER_ALERT_THRESHOLD=0.45
FRAUD_RISK_HIGH_THRESHOLD=70.0
FRAUD_RISK_MED_THRESHOLD=30.0
